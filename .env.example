# Optional. You do not need this file to use Noema: open the app and enter
# your API key on the "Connect a model" screen. A key saved in the app
# overrides the values here. Copy to .env to use; .env is git-ignored.

# Any OpenAI-compatible endpoint. DeepSeek works from Hong Kong.
NOEMA_LLM_BASE_URL=https://api.deepseek.com
NOEMA_LLM_API_KEY=
NOEMA_LLM_MODEL=deepseek-flash

# Where the notebook lives. One SQLite file; back it up or export it.
# Model settings saved in the app go next to it, in settings.json.
NOEMA_DB_PATH=data/noema.db

# The server only listens on this machine.
NOEMA_HOST=127.0.0.1
NOEMA_PORT=8787

# Automated tests set NOEMA_PROVIDER=fake (fixed answers, no network, no cost).
