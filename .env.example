# Copy to .env and fill in. .env is git-ignored; never commit a key.

# fake (no network, for tests and demos) or openai-compatible (DeepSeek, Qwen, Kimi, GLM, ...)
NOEMA_PROVIDER=fake

# OpenAI-compatible endpoint. DeepSeek works from Hong Kong; OpenAI and Anthropic don't list it.
NOEMA_LLM_BASE_URL=https://api.deepseek.com
NOEMA_LLM_API_KEY=
NOEMA_LLM_MODEL=deepseek-chat

# Where the notebook lives. One SQLite file; back it up or export it.
NOEMA_DB_PATH=data/noema.db

# The server only listens on this machine.
NOEMA_HOST=127.0.0.1
NOEMA_PORT=8787
